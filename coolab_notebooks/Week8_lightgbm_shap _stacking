    "    y_tr_es, y_val_es = y[:split_idx], y[split_idx:]\n",
    "    \n",
    "    params = {\n",
    "        \"num_leaves\": trial.suggest_categorical(\"num_leaves\", search_space[\"num_leaves\"]),\n",
    "        \"min_data_in_leaf\": trial.suggest_categorical(\"min_data_in_leaf\", search_space[\"min_data_in_leaf\"]),\n",
    "        \"bagging_fraction\": trial.suggest_categorical(\"bagging_fraction\", search_space[\"bagging_fraction\"]),\n",
    "        \"learning_rate\": 0.05,\n",
    "        \"n_estimators\": 2000,\n",
    "        \"bagging_freq\": 1,\n",
    "        \"random_state\": 42,\n",
    "        \"n_jobs\": -1,\n",
    "        \"verbose\": -1\n",
    "    }\n",
    "    \n",
    "    # Find best_n via early stopping\n",
    "    es_model = LGBMClassifier(**params)\n",
    "    es_model.fit(\n",
    "        X_tr_es, y_tr_es,\n",
    "        eval_set=[(X_val_es, y_val_es)],\n",
    "        eval_metric='auc',\n",
    "        callbacks=[early_stopping(stopping_rounds=50, verbose=False)]\n",
    "    )\n",
    "    \n",
    "    # Fallback safety if early stopping fails to yield a valid best_iteration\n",
    "    best_n = es_model.best_iteration_\n",
    "    if best_n is None or best_n <= 0:\n",
