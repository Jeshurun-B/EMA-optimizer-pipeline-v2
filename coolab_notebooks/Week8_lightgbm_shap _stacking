    "# TODO: specifically confirm: does the saved class_target_2 / class_target_3_corrected baseline\n",
    "#       actually reflect Week 3/4 LogReg's number (the thing RF lost to), or RF's own (weaker) number?\n",
    "#       Week 7's narrative assumed the former without re-checking the saved JSON value directly.\n",
    "rf_vs_xgb_tally = {}\n",
    "# ============================================================\n",
    "# PART A.11 — RF vs. XGBoost Tally Compilation & Unification\n",
    "# ============================================================\n",
    "import os\n",
    "import json\n",
    "import ast\n",
    "\n",
    "# 1. Path Definitions: Relying on explicit paths defined in A.10 to prevent missing file errors.\n",
    "rf_json_path = os.path.join(RF_RESULTS_DIR, \"week7_baselines_to_beat.json\")\n",
    "xgb_json_path = os.path.join(XGB_RESULTS_DIR, \"week8_baselines_to_beat.json\")\n",
    "\n",
    "# 2. Defensive File Loading: Catch missing files immediately rather than failing downstream.\n",
    "try:\n",
    "    with open(rf_json_path, 'r') as f:\n",
    "        rf_raw = json.load(f)\n",
    "    with open(xgb_json_path, 'r') as f:\n",
    "        xgb_raw = json.load(f)\n",
    "except FileNotFoundError as e:\n",
    "    raise RuntimeError(f\"CRITICAL WARNING: Missing JSON baseline files.\\n{e}\")\n",
    "\n",
    "# 3. Data Normalization (RF): Convert stringified tuples \"('target', 'direction')\" into standardized keys.\n",
    "rf_norm = {}\n",
    "for k_str, data in rf_raw.items():\n",
    "    # ast.literal_eval is a safe way to parse strings that look like Python tuples without using eval()\n",
    "    target, direction = ast.literal_eval(k_str) \n",
    "    rf_norm[f\"{target}_{direction}\"] = {\n",
    "        'score': data['score'],\n",
    "        'model': data['model']\n",
    "    }\n",
    "\n",
    "# 4. Data Normalization (XGBoost): Flatten the deeply nested dict into standard keys.\n",
    "xgb_norm = {}\n",
    "for task, directions in xgb_raw.items():\n",
    "    for direction, targets in directions.items():\n",
    "        for target, data in targets.items():\n",
    "            # Dynamically extract either AUC (classification) or R2 (regression)\n",
    "            score = data.get('Best_AUC', data.get('Best_R2'))\n",
    "            xgb_norm[f\"{target}_{direction}\"] = {\n",
    "                'score': score,\n",
    "                'model': 'XGBoost',\n",
    "                'task': task,\n",
    "                'params': data.get('Params')\n",
    "            }\n",
    "\n",
    "# 5. Pipeline Integrity Check: Ensure both dictionaries contain the exact same targets.\n",
    "missing_in_rf  = sorted(set(xgb_norm) - set(rf_norm))\n",
    "missing_in_xgb = sorted(set(rf_norm) - set(xgb_norm))\n",
    "if missing_in_rf or missing_in_xgb:\n",
    "    print(\"KEY MISMATCH DETECTED:\")\n",
    "    if missing_in_rf:  print(f\"  In XGBoost but not RF:  {missing_in_rf}\")\n",
    "    if missing_in_xgb: print(f\"  In RF but not XGBoost:  {missing_in_xgb}\")\n",
    "\n",
    "# 6. Tally and Dictionary Unification\n",
    "xgb_wins = 0\n",
    "total_comparisons = 0\n",
    "unified_baselines_to_beat = {}\n",
    "\n",
    "print(\"============================================================\")\n",
    "print(\"RF vs. XGBOOST WIN/LOSS TALLY\")\n",
    "print(\"============================================================\\n\")\n",
    "\n",
    "# Iterate through the standardized keys\n",
    "for key in sorted(xgb_norm.keys()):\n",
    "    if key not in rf_norm:\n",
    "        continue # Safely skip mismatches caught by the integrity check above\n",
    "        \n",
    "    total_comparisons += 1\n",
    "    \n",
    "    # Reverse-engineer the target and direction from our unified key (e.g., 'class_target_1_LONG')\n",
    "    # rsplit('_', 1) splits only on the LAST underscore, handling targets with underscores safely\n",
    "    target_name = key.rsplit('_', 1)[0] \n",
    "    direction = key.rsplit('_', 1)[1]   \n",
    "    \n",
    "    xgb_score = xgb_norm[key]['score']\n",
    "    rf_score = rf_norm[key]['score']\n",
    "    rf_model_name = rf_norm[key]['model']\n",
    "    \n",
    "    # Determine the winner. For both AUC and R2, higher is strictly better.\n",
    "    if xgb_score > rf_score:\n",
    "        xgb_wins += 1\n",
    "        winner = \"XGBoost\"\n",
    "        best_score = xgb_score\n",
    "        best_model = \"XGBoost\"\n",
    "        best_params = xgb_norm[key]['params']\n",
    "    else:\n",
    "        winner = rf_model_name\n",
    "        best_score = rf_score\n",
    "        best_model = rf_model_name\n",
    "        best_params = None # Leaving None since RF params aren't mapped in this snippet\n",
    "\n",
    "    print(f\"{key:<35} | RF/LogReg: {rf_score:.4f} vs XGBoost: {xgb_score:.4f} --> WINNER: {winner}\")\n",
    "    \n",
    "    # Populate the final, flat dictionary structure for downstream use\n",
    "    unified_baselines_to_beat[key] = {\n",
    "        \"target\": target_name,\n",
    "        \"direction\": direction,\n",
    "        \"task\": xgb_norm[key]['task'],\n",
    "        \"primary_metric\": \"auc\" if xgb_norm[key]['task'] == \"classification\" else \"r2\",\n",
    "        \"best_score\": best_score,\n",
    "        \"best_model\": best_model,\n",
    "        \"params\": best_params\n",
    "    }\n",
    "\n",
    "# 7. Final Sanity Checks\n",
    "print(f\"\\nFINAL TALLY: XGBoost beat the prior baseline on {xgb_wins} / {total_comparisons} combos.\")\n",
    "assert total_comparisons == 18, f\"Expected 18 combos, compared {total_comparisons} -- investigate mismatch above.\"\n",
    "\n",
    "# Save the unified baseline for immediate use by LightGBM and stacking models\n",
    "save_result_dict(unified_baselines_to_beat, \"unified_baselines_to_beat\")\n"
   ]
  },
