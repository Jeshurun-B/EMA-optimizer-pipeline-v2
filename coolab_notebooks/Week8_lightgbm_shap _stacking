    "## ============================================================\n",
    "# PART B — Joint Parameter Sweep for 'quality' (LONG)\n",
    "# ============================================================\n",
    "import optuna\n",
    "from lightgbm import LGBMRegressor\n",
    "\n",
    "print(\"============================================================\")\n",
    "print(\"Optuna Grid Sweep: 'quality' | LONG\")\n",
    "print(\"============================================================\\n\")\n",
    "\n",
    "# 1. Setup Data strictly from Part A variables\n",
    "target_name = 'quality'\n",
    "target_col, transform_str = REG_TARGETS[target_name]\n",
    "\n",
    "# Sort chronologically and drop NAs using df_long and feat_set_long directly\n",
    "df_clean = df_long.sort_values('checked_at_utc')[feat_set_long + [target_col]].dropna()\n",
    "\n",
    "# 2. Define the discrete search space explicitly\n",
    "search_space = {\n",
    "    \"num_leaves\": [15, 31, 63],\n",
    "    \"min_data_in_leaf\": [20, 50, 100],\n",
    "    \"bagging_fraction\": [1.0, 0.8]\n",
    "}\n",
    "\n",
    "# 3. Define the Objective Function\n",
    "def objective(trial):\n",
    "    # Fetch parameters from the defined search space\n",
    "    num_leaves = trial.suggest_categorical(\"num_leaves\", search_space[\"num_leaves\"])\n",
    "    min_data_in_leaf = trial.suggest_categorical(\"min_data_in_leaf\", search_space[\"min_data_in_leaf\"])\n",
    "    bagging_fraction = trial.suggest_categorical(\"bagging_fraction\", search_space[\"bagging_fraction\"])\n",
    "    \n",
    "    # Initialize model with fixed learning rate and verbose=-1 (silence clutter)\n",
    "    model = LGBMRegressor(\n",
    "        n_estimators=300,        # Standard fixed tree count for the sweep\n",
    "        learning_rate=0.05,\n",
    "        num_leaves=num_leaves,\n",
    "        min_data_in_leaf=min_data_in_leaf,\n",
    "        bagging_fraction=bagging_fraction,\n",
    "        bagging_freq=1,          # MANDATORY: Required for bagging_fraction to activate\n",
    "        random_state=42,\n",
    "        n_jobs=-1,\n",
    "        verbose=-1\n",
    "    )\n",
    "    \n",
    "    # Run standardized CV from Part A\n",
    "    target_info = (target_col, transform_str)\n",
    "    cv_scores = cv_regression(\n",
    "        model=model, \n",
    "        df_subset=df_clean, \n",
    "        feature_cols=feat_set_long, \n",
    "        target_info=target_info, \n",
    "        n_splits=5, \n",
    "        gap=0,\n",
    "        scale=False\n",
    "    )\n",
    "    \n",
    "    # Log the MAE as user-defined tracking metric, but optimize on R2\n",
    "    trial.set_user_attr(\"cv_mae\", cv_scores['mae'][0])\n",
    "    \n",
    "    # We return R2 to the optimizer to maximize it\n",
    "    return cv_scores['r2'][0]\n",
    "\n",
    "# 4. Initialize SQLite Persistent Storage and GridSampler\n",
    "study_name = \"lgbm_quality_long_sweep\"\n",
    "storage_name = f\"sqlite:///{study_name}.db\"\n",
    "\n",
    "# Optuna's GridSampler ensures exactly 18 distinct runs with no overlapping/wasted trials\n",
    "study = optuna.create_study(\n",
    "    study_name=study_name,\n",
    "    storage=storage_name,\n",
    "    sampler=optuna.samplers.GridSampler(search_space),\n",
    "    direction=\"maximize\",\n",
    "    load_if_exists=True\n",
    ")\n",
    "\n",
    "# 5. Execute the Sweep\n",
    "print(\"Starting grid sweep (18 distinct combinations)...\")\n",
    "# We pass n_trials=18 to cover the exact grid size; it will automatically stop if already complete.\n",
    "study.optimize(objective, n_trials=18)\n",
    "\n",
    "# 6. Report Best Results\n",
    "print(\"\\n--- SWEEP COMPLETE ---\")\n",
    "print(f\"Best Trial Score (R2): {study.best_value:.4f}\")\n",
    "print(f\"Best Trial MAE: {study.best_trial.user_attrs.get('cv_mae'):.4f}\")\n",
    "print(\"Best Parameters:\")\n",
    "for key, value in study.best_params.items():\n",
    "    print(f\"    {key}: {value}\")"
