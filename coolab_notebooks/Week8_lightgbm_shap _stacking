t way now — resist the temptation to just run it on whichever model happens to be loaded in memory.","metadata":{}},{"cell_type":"markdown","source":"### SHAP summary plot — do all three models agree on global importance and direction?","metadata":{}},{"cell_type":"code","source":"# TODO: import shap\n# TODO: for EACH of RF (Week 6's saved .joblib), XGBoost (Week 7's saved .joblib),\n#       and LightGBM (this week's model), build shap.TreeExplainer and shap_values\n#       on the SAME held-out fold / same feature set / same target, so the three are comparable.\n# TODO: shap.summary_plot() for each, side by side (or in one figure)\n# TODO: compare each model's top-10 SHAP features against Week 6's permutation-importance\n#       top-10 for the SAME target -- do all three agree with permutation more than MDI did\n#       in Week 6 (recall: MDI vs permutation only overlapped 4-6/10)?\n# ============================================================\n# PART C.1 — SHAP Summary Plot: RF vs XGBoost vs LightGBM\n# ============================================================\nimport shap\nimport pandas as pd\nimport numpy as np\nimport matplotlib.pyplot as plt\n\n# Initialize SHAP JavaScript visualization module (if needed for other plots later)\nshap.initjs()\n\n# ------------------------------------------------------------\n# Step 1: Select Target and Rebuild Models\n# ------------------------------------------------------------\n# Choose one of your primary targets to analyze. \ntarget_to_explain = 'class_target_1'  \ndirection_to_explain = 'LONG'\ntask_to_explain = 'classification'\n\nrf_model, xgb_model, lgbm_model, X_train_full, y_train_full, feat_cols = rebuild_three_models(\n    target_to_explain, direction_to_explain, task_to_explain\n)\n\n# ------------------------------------------------------------\n# Step 2: Isolate the Held-Out Fold & Sample for Speed\n# ------------------------------------------------------------\n# Take the final 15% chronologically\nsplit_idx = int(len(X_train_full) * 0.85)\nX_held_out = X_train_full[split_idx:]\n\n# SHAP on Random Forests can be incredibly slow. Cap at 1500 rows.\n# Taking the *last* 1500 rows of the held-out set preserves chronology.\nmax_shap_samples = 1500\nif len(X_held_out) > max_shap_samples:\n    X_sample = X_held_out[-max_shap_samples:]\nelse:\n    X_sample = X_held_out\n\n# Convert to DataFrame so SHAP plots automatically label the axes\nX_sample_df = pd.DataFrame(X_sample, columns=feat_cols)\nprint(f\"Calculating SHAP values on {len(X_sample_df)} held-out samples...\")\n\n# ------------------------------------------------------------\n# Step 3: Compute SHAP Values (with list-type safety)\n# ------------------------------------------------------------\ndef get_shap_values(model, X_df):\n    \"\"\"\n    Safely calculates and extracts positive-class SHAP values.\n    \"\"\"\n    # check_additivity=False prevents errors on heavily regularized LightGBM/XGB models\n    explainer = shap.TreeExplainer(model)\n    shap_vals = explainer.shap_values(X_df, check_additivity=False)\n    \n    # If the model is a classifier that outputs [negative_class, positive_class], extract index 1\n    if isinstance(shap_vals, list):\n        return shap_vals[1]\n    # In newer SHAP versions or certain regressors, it might return an Explanation object\n    elif str(type(shap_vals)).find(\"Explanation\") > -1:\n        return shap_vals.values\n    return shap_vals\n\nprint(\"  -> Explaining Random Forest (this may take a minute)...\")\nshap_rf = get_shap_values(rf_model, X_sample_df)\n\nprint(\"  -> Explaining XGBoost...\")\nshap_xgb = get_shap_values(xgb_model, X_sample_df)\n\nprint(\"  -> Explaining LightGBM...\")\nshap_lgbm = get_shap_values(lgbm_model, X_sample_df)\n\n# ------------------------------------------------------------\n# Step 4: Generate Side-by-Side Summary Plots\n# ------------------------------------------------------------\n# Create a wide figure to hold 3 plots side-by-side\nfig = plt.figure(figsize=(24, 8))\n\n# Subplot 1: Random Forest\nplt.subplot(1, 3, 1)\nplt.title(f\"Random Forest SHAP\\n({target_to_explain} | {direction_to_explain})\", fontsize=14, fontweight='bold')\n# plot_size=None prevents SHAP from forcefully resizing the matplotlib figure\nshap.summary_plot(shap_rf, X_sample_df, show=False, plot_size=None) \n\n# Subplot 2: XGBoost\nplt.subplot(1, 3, 2)\nplt.title(f\"XGBoost SHAP\\n({target_to_explain} | {direction_to_explain})\", fontsize=14, fontweight='bold')\nshap.summary_plot(shap_xgb, X_sample_df, show=False, plot_size=None)\n\n# Subplot 3: LightGBM\nplt.subplot(1, 3, 3)\nplt.title(f\"LightGBM SHAP\\n({target_to_explain} | {direction_to_explain})\", fontsize=14, fontweight='bold')\nshap.summary_plot(shap_lgbm, X_sample_df, show=False, plot_size=None)\n\nplt.tight_layout()\nplt.show()\n\n# ------------------------------------------------------------\n# Step 5: Extract and Print Top 10 Features for Easy Comparison\n# ------------------------------------------------------------\ndef get_top_n_features(shap_array, features, n=10):\n    \"\"\"\n    Calculates the mean absolute SHAP value per feature and returns the top N.\n    \"\"\"\n    mean_abs_shap = np.abs(shap_array).mean(axis=0)\n    top_indices = np.argsort(mean_abs_shap)[::-1][:n]\n    return [features[i] for i in top_indices]\n\ntop_rf = get_top_n_features(shap_rf, feat_cols)\ntop_xgb = get_top_n_features(shap_xgb, feat_cols)\ntop_lgbm = get_top_n_features(shap_lgbm, feat_cols)\n\nprint(\"\\n============================================================\")\nprint(f\"TOP 10 SHAP FEATURES ({target_to_explain} | {direction_to_explain})\")\nprint(\"Compare this against your Week 6 Permutation Importance list\")\nprint(\"============================================================\\n\")\n\ndf_top_10 = pd.DataFrame({\n    'Rank': range(1, 11),\n    'Random Forest': top_rf,\n    'XGBoost': top_xgb,\n    'LightGBM': top_lgbm\n})\n\nprint(df_top_10.to_string(index=False))","metadat