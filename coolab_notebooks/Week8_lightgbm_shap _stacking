n is_log flag.\nlgbm_reg_results = {}\n# ============================================================\n# PART B — Train LGBMRegressor with early stopping\n# ============================================================\nfrom lightgbm import LGBMRegressor, early_stopping, log_evaluation\nimport numpy as np\nimport warnings\n\n# Suppress LightGBM's default warning spam during CV\nwarnings.filterwarnings('ignore', category=UserWarning, module='lightgbm')\n\n# Utilizing the dictionaries established in Part A\ndirections = {'LONG': (df_long, feat_set_long), 'SHORT': (df_short, feat_set_short)}\n\nlgbm_reg_results = {}\n\nprint(\"============================================================\")\nprint(\"LightGBM Regression Baseline (Early Stopping)\")\nprint(\"============================================================\\n\")\n\nfor target_name, (target_col, transform_str) in REG_TARGETS.items():\n    for dir_name, (df_sub, feat_cols) in directions.items():\n        print(f\"--- Training {target_name} ({target_col}) | {dir_name} ---\")\n        \n        # 1. Sort using 'checked_at_utc' directly, THEN slice and drop NAs\n        df_clean = df_sub.sort_values('checked_at_utc')[feat_cols + [target_col]].dropna()\n        \n        X = df_clean[feat_cols].values\n        y = df_clean[target_col].values\n        \n        # 2. Split the final 15% chronologically for Early Stopping validation\n        split_idx = int(len(X) * 0.85)\n        X_tr_es, y_tr_es = X[:split_idx], y[:split_idx]\n        X_va_es, y_va_es = X[split_idx:], y[split_idx:]\n        \n        # 3. Explicit Target Transformation with Strict Assertion\n        offset = {'log1p': 1, 'log5p': 5}.get(transform_str, None)\n        \n        if offset is not None:\n            min_tr, min_va = y_tr_es.min(), y_va_es.min()\n            assert min_tr + offset > 0 and min_va + offset > 0, (\n                f\"{target_name}: offset={offset} insufficient, \"\n                f\"min values are {min_tr:.4f} (train) / {min_va:.4f} (val) -- log() would produce NaN\"\n            )\n            y_tr_es_fit = np.log(y_tr_es + offset)\n            y_va_es_fit = np.log(y_va_es + offset)\n        else:\n            y_tr_es_fit = y_tr_es\n            y_va_es_fit = y_va_es\n            \n        # 4. Initialize baseline model (constrained num_leaves)\n        es_model = LGBMRegressor(\n            n_estimators=1500,\n            learning_rate=0.05,\n            num_leaves=15,\n            random_state=42,\n            n_jobs=-1\n        )\n        \n        # 5. Fit with early stopping (patience = 50 rounds)\n        es_model.fit(\n            X_tr_es, y_tr_es_fit,\n            eval_set=[(X_va_es, y_va_es_fit)],\n            callbacks=[\n                early_stopping(stopping_rounds=50, verbose=False),\n                log_evaluation(period=0)\n            ]\n        )\n        \n        # 6. Extract the 1-indexed best iteration\n        best_n = es_model.best_iteration_\n        \n        if best_n is None or best_n <= 0:\n            best_n = 100 \n            \n        print(f\"Optimal trees found: {best_n}\")\n        \n        # 7. Re-instantiate the model with the strictly fixed n_estimators\n        final_model = LGBMRegressor(\n            n_estimators=best_n,\n            learning_rate=0.05,\n            num_leaves=15,\n            random_state=42,\n            n_jobs=-1\n        )\n        \n        # 8. Evaluate using our standardized walk-forward CV framework\n        target_info = (target_col, transform_str)\n        \n        cv_scores = cv_regression(\n            model=final_model, \n            df_subset=df_clean, \n            feature_cols=feat_cols, \n            target_info=target_info, \n            n_splits=5, \n            gap=0,\n            scale=False # Trees remain scale-invariant\n        )\n        \n        # 9. Store and report (Logging MAE specifically for your PnL shift)\n        key = f\"{target_name}_{dir_name}\"\n        lgbm_reg_results[key] = {\n            'best_n': best_n,\n            'cv_r2': cv_scores['r2'][0],\n            'cv_rmse': cv_scores['rmse'][0],\n            'cv_mae': cv_scores['mae'][0]\n        }\n        \n        print(f\"CV R2:   {cv_scores['r2'][0]:.4f} +/- {cv_scores['r2'][1]:.4f}\")\n        print(f\"CV RMSE: {cv_scores['rmse'][0]:.4f}\")\n        print(f\"CV MAE:  {cv_scores['mae'][0]:.4f}\\n\")","metadata":{"execution":{"iopub.status.busy":"2026-07-29T23:24:33.152424Z","iopub.execute_input":"2026-07-29T23:24:33.153169Z","iopub.status.idle":"2026-07-29T23:26:15.926023Z","shell.execute_reply.started":"2026-07-29T23:24:33.153140Z","shell.execute_reply":"2026-07-29T23:26:15.925010Z"},"collapsed":true,"jupyter":{"outputs_hidden":true},"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# ============================================================\n# PART B — Full LightGBM Grid Sweep (Fully Hardened)\n# ============================================================\nimport optuna\nimport time\nimport numpy as np\nimport traceback\nfrom lightgbm import LGBMClassifier, LGBMRegressor\nfrom lightgbm.callback import early_stopping\nfrom optuna.trial import TrialState\n\nprint(f\"[{time.strftime('%Y-%m-%d %H:%M:%S')}] INITIALIZING HARDENED LIGHTGBM GRID SWEEP\")\nprint(\"===================================================================================\\n\")\n\n# 1. Define the exact, fixed search space (18 total combinations)\nsearch_space = {\n    \"num_leaves\": [15, 31, 63],\n    \"min_data_in_leaf\": [20, 50, 100],\n    \"bagging_fraction\": [1.0, 0.8]\n}\nTOTAL_GRID_SIZE = 18\n\n# 2. Setup targets and mapping from Part A\nclass_targets = ['class_target_1', 'class_target_2', 'class_target_3_corrected', 'class_target_bad']\nreg_targets = list(REG_TARGETS.keys())\ndirection_map = {\n    'LONG': (df_long, feat_set_long),\n    'SHORT': (df_short, feat_set_short)\n}\n\n# Dictionary to hold the final compiled results\nlightgbm_sweep_1 = {\n    'classification': {'LONG': {}, 'SHORT': {}},\n    'regression': {'LONG': {}, 'SHORT': {}}\n}\n\n# ============================================================\n# OBJECTIVE: CLASSIFICATION\n# ============================================================\ndef objective_clf(trial, df_sub, feat_cols, target_col):\n    df_clean = df_sub.sort_values('checked_at_utc')[feat_cols + [target_col]].dropna()\n    X = df_clean[feat_cols].values\n    y = df_clean[target_col].values\n    \n    # Chronological 85/15 split for Early Stopping (Finding best_n)\n    split_idx = int(len(X) * 0.85)\n    X_tr_es, X_val_es = X[:split_idx], X[split_idx:]\n    y_tr_es, y_val_es = y[:split_idx], y[split_idx:]\n    \n    params = {\n        \"num_leaves\": trial.suggest_categorical(\"num_leaves\", search_space[\"num_leaves\"]),\n        \"min_data_in_leaf\": trial.suggest_categorical(\"min_data_in_leaf\", search_space[\"min_data_in_leaf\"]),\n        \"bagging_fraction\": trial.suggest_categorical(\"bagging_fraction\", search_space[\"bagging_fraction\"]),\n        \"learning_rate\": 0.05,\n        \"n_estimators\": 2000,\n        \"bagging_freq\": 1,\n        \"random_state\": 42,\n        \"n_jobs\": -1,\n        \"verbose\": -1\n    }\n    \n    # Find best_n via early stopping\n    es_model = LGBMClassifier(**params)\n    es_model.fit(\n        X_tr_es, y_tr_es,\n        eval_set=[(X_val_es, y_val_es)],\n        eval_metric='auc',\n        callbacks=[early_stopping(stopping_rounds=50, verbose=False)]\n    )\n    \n    # Fallback safety if early stopping fails to yield a valid best_iteration\n    best_n = es_model.best_iteration_\n    if best_n is None or best_n <= 0:\n        print(f\"    [Warning] CLF Early stopping yielded invalid best_iteration ({best_n}). Defaulting to 100.\")\n        best_n = 100\n        \n    # Inject best_n and run full walk-forward CV\n    params[\"n_estimators\"] = best_n\n    cv_model = LGBMClassifier(**params)\n    \n    cv_scores = cv_no_scaling(\n        model=cv_model,\n        df_subset=df_clean,\n        feature_cols=feat_cols,\n        target_col=target_col,\n        n_splits=5, gap=0\n    )\n    \n    trial.set_user_attr(\"best_n\", best_n)\n    trial.set_user_attr(\"cv_accuracy\", cv_scores['accuracy'][0])\n    trial.set_user_attr(\"cv_precision\", cv_scores['precision'][0])\n    \n    return cv_scores['auc'][0]\n\n# ============================================================\n# OBJECTIVE: REGRESSION\n# ============================================================\ndef objective_reg(trial, df_sub, feat_cols, target_info):\n    target_col, transform_str = target_info\n    df_clean = df_sub.sort_values('checked_at_utc')[feat_cols + [target_col]].replace([np.inf, -np.inf], np.nan).dropna()\n    X = df_clean[feat_cols].values\n    y = df_clean[target_col].values\n    \n    # Chronological 85/15 split for Early Stopping\n    split_idx = int(len(X) * 0.85)\n    X_tr_es, X_val_es = X[:split_idx], X[split_idx:]\n    y_tr_es_raw, y_val_es_raw = y[:split_idx], y[split_idx:]\n    \n    # Apply identical log transformations with domain assertions\n    if transform_str == 'log1p':\n        assert np.all(y_tr_es_raw > -1.0) and np.all(y_val_es_raw > -1.0), f\"log1p domain error on {target_col}\"\n        y_tr_es = np.log1p(y_tr_es_raw)\n        y_val_es = np.log1p(y_val_es_raw)\n    elif transform_str == 'log5p':\n        assert np.all(y_tr_es_raw > -5.0) and np.all(y_val_es_raw > -5.0), f\"log5p domain error on {target_col}\"\n        y_tr_es = np.log(y_tr_es_raw + 5)\n        y_val_es = np.log(y_val_es_raw + 5)\n    else:\n        y_tr_es, y_val_es = y_tr_es_raw, y_val_es_raw\n    \n    params = {\n        \"num_leaves\": trial.suggest_categorical(\"num_leaves\", search_space[\"num_leaves\"]),\n        \"min_data_in_leaf\": trial.suggest_categorical(\"min_data_in_leaf\", search_space[\"min_data_in_leaf\"]),\n        \"bagging_fraction\": trial.suggest_categorical(\"bagging_fraction\", search_space[\"bagging_fraction\"]),\n        \"learning_rate\": 0.05,\n        \"n_estimators\": 2000, \n        \"bagging_freq\": 1,\n        \"random_state\": 42,\n        \"n_jobs\": -1,\n        \"verbose\": -1\n    }\n    \n    # Find best_n via early stopping\n    es_model = LGBMRegressor(**params)\n    es_model.fit(\n        X_tr_es, y_tr_es,\n        eval_set=[(X_val_es, y_val_es)],\n        eval_metric='rmse',\n        callbacks=[early_stopping(stopping_rounds=50, verbose=False)]\n    )\n    \n    # Fallback safety if early stopping fails to yield a valid best_iteration\n    best_n = es_model.best_iteration_\n    if best_n is None or best_n <= 0:\n        print(f\"    [Warning] REG Early stopping yielded invalid best_iteration ({best_n}). Defaulting to 100.\")\n        best_n = 100\n        \n    # Inject best_n and run full walk-forward CV\n    params[\"n_estimators\"] = best_n\n    cv_model = LGBMRegressor(**params)\n    \n    cv_scores = cv_regression(\n        model=cv_model,\n        df_subset=df_clean,\n        feature_cols=feat_cols,\n        target_info=target_info,\n        n_splits=5, gap=0, scale=False\n    )\n    \n    trial.set_user_attr(\"best_n\", best_n)\n    trial.set_user_attr(\"cv_mae\", cv_scores['mae'][0])\n    \n    return cv_scores['r2'][0]\n\n# ============================================================\n# EXECUTE LOOPS\n# ============================================================\n\n# --- 1. CLASSIFICATION SWEEPS ---\nfor c_target in class_targets:\n    for direction in ['LONG', 'SHORT']:\n        print(f\"\\n[{time.strftime('%Y-%m-%d %H:%M:%S')}] Starting CLASSIFICATION sweep: {c_target} | {direction}\")\n        \n        try:\n            df_sub, feat_cols = direction_map[direction]\n            study_name = f\"lgbm_sweep1_clf_{c_target}_{direction}\"\n            storage_name = f\"sqlite:///{study_name}.db\"\n            \n            study = optuna.create_study(\n                study_name=study_name, storage=storage_name,\n                sampler=optuna.samplers.GridSampler(search_space),\n                direction=\"maximize\", load_if_exists=True\n            )\n            \n            # Resume safety: Only run the remaining trials needed to hit exactly 18\n            completed_trials = len([t for t in study.trials if t.state == TrialState.COMPLETE])\n            remaining = TOTAL_GRID_SIZE - completed_trials\n            \n            if remaining > 0:\n                study.optimize(lambda trial: objective_clf(trial, df_sub, feat_cols, c_target), n_trials=remaining)\n            else:\n                print(f\"    [Skip] Sweep already completed {completed_trials}/{TOTAL_GRID_SIZE} trials.\")\n            \n            # Log Best Results\n            best_p = study.best_params\n            best_n = study.best_trial.user_attrs.get(\"best_n\")\n            best_p[\"n_estimators\"] = best_n if best_n else 100\n            best_p[\"learning_rate\"] = 0.05\n            best_p[\"bagging_freq\"] = 1\n            \n            lightgbm_sweep_1['classification'][direction][c_target] = {\n                'Best_AUC': study.best_value,\n                'Best_Precision': study.best_trial.user_attrs.get(\"cv_precision\"),\n                'best_n': best_n,\n                'Params': best_p\n            }\n            \n            # Train final model on full dataset and write to disk\n            final_model = LGBMClassifier(**best_p, random_state=42, n_jobs=-1, verbose=-1)\n            df_clean = df_sub.sort_values('checked_at_utc')[feat_cols + [c_target]].dropna()\n            final_model.fit(df_clean[feat_cols].values, df_clean[c_target].values)\n            \n            model_name = f\"LGBM_CLF_{direction}_{c_target}_sweep1\"\n            save_model(final_model, model_name)\n            \n            print(f\"[{time.strftime('%Y-%m-%d %H:%M:%S')}] -> Best AUC: {study.best_value:.4f} (Trees: {best_p['n_estimators']})\")\n            \n        except Exception as e:\n            print(f\"\\nCRITICAL ERROR on CLASSIFICATION {c_target} | {direction}. Moving to next.\")\n            traceback.print_exc()\n            continue\n\n# --- 2. REGRESSION SWEEPS ---\nfor r_target in reg_targets:\n    for direction in ['LONG', 'SHORT']:\n        print(f\"\\n[{time.strftime('%Y-%m-%d %H:%M:%S')}] Starting REGRESSION sweep: {r_target} | {direction}\")\n        \n        try:\n            df_sub, feat_cols = direction_map[direction]\n            target_info = REG_TARGETS[r_target]\n            \n            study_name = f\"lgbm_sweep1_reg_{r_target}_{direction}\"\n            storage_name = f\"sqlite:///{study_name}.db\"\n            \n            study = optuna.create_study(\n                study_name=study_name, storage=storage_name,\n                sampler=optuna.samplers.GridSampler(search_space),\n                direction=\"maximize\", load_if_exists=True\n            )\n            \n            # Resume safety\n            completed_trials = len([t for t in study.trials if t.state == TrialState.COMPLETE])\n            remaining = TOTAL_GRID_SIZE - completed_trials\n            \n            if remaining > 0:\n                study.optimize(lambda trial: objective_reg(trial, df_sub, feat_cols, target_info), n_trials=remaining)\n            else:\n                print(f\"    [Skip] Sweep already completed {completed_trials}/{TOTAL_GRID_SIZE} trials.\")\n            \n            # Log Best Results\n            best_p = study.best_params\n            best_n = study.best_trial.user_attrs.get(\"best_n\")\n            best_p[\"n_estimators\"] = best_n if best_n else 100\n            best_p[\"learning_rate\"] = 0.05\n            best_p[\"bagging_freq\"] = 1\n            \n            lightgbm_sweep_1['regression'][direction][r_target] = {\n                'Best_R2': study.best_value,\n                'Best_MAE': study.best_trial.user_attrs.get(\"cv_mae\"),\n                'best_n': best_n,\n                'Params': best_p\n            }\n            \n            # Train final model on full dataset and write to disk\n            final_model = LGBMRegressor(**best_p, random_state=42, n_jobs=-1, verbose=-1)\n            target_col, transform_str = target_info\n            df_clean = df_sub.sort_values('checked_at_utc')[feat_cols + [target_col]].replace([np.inf, -np.inf], np.nan).dropna()\n            \n            y_final = df_clean[target_col].values\n            if transform_str == 'log1p': y_final = np.log1p(y_final)\n            elif transform_str == 'log5p': y_final = np.log(y_final + 5)\n            \n            final_model.fit(df_clean[feat_cols].values, y_final)\n            \n            model_name = f\"LGBM_REG_{direction}_{r_target}_sweep1\"\n            save_model(final_model, model_name)\n            \n            cv_mae = study.best_trial.user_attrs.get('cv_mae')\n            print(f\"[{time.strftime('%Y-%m-%d %H:%M:%S')}] -> Best R2: {study.best_value:.4f} | MAE: {cv_mae:.4f} (Trees: {best_p['n_estimators']})\")\n            \n        except Exception as e:\n            print(f\"\\nCRITICAL ERROR on REGRESSION {r_target} | {direction}. Moving to next.\")\n            traceback.print_exc()\n            continue\n\n# 3. Save the comprehensive sweep dictionary and git state\ntry:\n    save_result_dict(lightgbm_sweep_1, \"lightgbm_sweep_1\")\n    print(f\"\\n[{time.strftime('%Y-%m-%d %H:%M:%S')}] ALL SWEEPS SAVED TO JSON.\")\n    \n    # Save git progress immediately\n    save_progress(\"Completed full LightGBM sweep 1 (all targets) with hardened error handling and resume logic.\")\n    print(\"Git state synced.\")\n    \nexcept Exception as e:\n    print(f\"\\nCRITICAL ERROR saving results or pushing to GitHub: {e}\")\n\nprint(\"===================================================================================\")","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"### Tune: `num_leaves`, `min_data_in_leaf`, `learning_rate`, `bagging_fraction` (joint sweep)","metadata":{}},{"cell_type":"code","source":"# ============================================================\n# PART B — Final TPE Sweep, Per-Family Ranges\n# ============================================================\nimport optuna\nimport time\nimport numpy as np\nimport traceback\nfrom lightgbm import LGBMClassifier, LGBMRegressor, early_stopping\nfrom optuna.trial import TrialState\n\n# ------------------------------------------------------------\n# 0. MAP SECTION A GLOBALS\n# Explicitly mapping variables from earlier in the notebook\n# ------------------------------------------------------------\nclass_targets = ['class_target_1', 'class_target_2', 'class_target_3_corrected', 'class_target_bad']\nreg_targets = list(REG_TARGETS.keys())\n\ndirection_map = {\n    'LONG': (df_long, feat_set_long),\n    'SHORT': (df_short, feat_set_short)\n}\n\n# ------------------------------------------------------------\n# 1. PER-FAMILY SEARCH SPACES\n# ------------------------------------------------------------\nFAMILY_RANGES = {\n    \"classification\": dict(num_leaves=(15,31), min_data_in_leaf=(80,150),\n                            bagging_fraction=(0.6,0.85), reg_alpha=(0,1.5), reg_lambda=(0,1.0), n_trials=70),\n    \n    \"danger\":         dict(num_leaves=(7,31),  min_data_in_leaf=(10,40),\n                            bagging_fraction=(0.6,0.85), reg_alpha=(0,1.0), reg_lambda=(0,1.0), n_trials=80),\n    \n    \"profit_quality\": dict(num_leaves=(7,31),  min_data_in_leaf=(80,200),\n                            bagging_fraction=(0.6,0.85), reg_alpha=(0,1.5), reg_lambda=(0,1.5), n_trials=70),\n    \n    \"weak_timing\":    dict(num_leaves=(7,15),  min_data_in_leaf=(100,200),\n                            bagging_fraction=(0.6,0.85), reg_alpha=(0,1.0), reg_lambda=(0,1.0), n_trials=40),\n}\n\ndef family_for_reg(target_name):\n    if target_name == \"danger\": return \"danger\"\n    if target_name in (\"profit\", \"quality\"): return \"profit_quality\"\n    return \"weak_timing\" \n\ndef build_params(trial, fam):\n    r = FAMILY_RANGES[fam]\n    return {\n        \"num_leaves\": trial.suggest_int(\"num_leaves\", *r[\"num_leaves\"]),\n        \"min_data_in_leaf\": trial.suggest_int(\"min_data_in_leaf\", *r[\"min_data_in_leaf\"]),\n        \"bagging_fraction\": trial.suggest_float(\"bagging_fraction\", *r[\"bagging_fraction\"]),\n        \"reg_alpha\": trial.suggest_float(\"reg_alpha\", *r[\"reg_alpha\"]),\n        \"reg_lambda\": trial.suggest_float(\"reg_lambda\", *r[\"reg_lambda\"]),\n        \"learning_rate\": 0.05, \n        \"n_estimators\": 2000, \n        \"bagging_freq\": 1,\n        \"random_state\": 42, \n        \"n_jobs\": -1, \n        \"verbose\": -1,\n    }\n\n# ------------------------------------------------------------\n# 2. OBJECTIVE FUNCTIONS\n# ------------------------------------------------------------\ndef objective_clf_final(trial, df_sub, feat_cols, target_col):\n    fam = \"classification\"\n    df_clean = df_sub.sort_values('checked_at_utc')[feat_cols + [target_col]].dropna()\n    X, y = df_clean[feat_cols].values, df_clean[target_col].values\n    \n    split_idx = int(len(X) * 0.85)\n    X_tr, X_val, y_tr, y_val = X[:split_idx], X[split_idx:], y[:split_idx], y[split_idx:]\n\n    params = build_params(trial, fam)\n    es_model = LGBMClassifier(**params)\n    \n    es_model.fit(X_tr, y_tr, eval_set=[(X_val, y_val)], eval_metric='auc',\n                 callbacks=[early_stopping(stopping_rounds=50, verbose=False)])\n    \n    best_n = es_model.best_iteration_\n    if best_n is None or best_n <= 0:\n        print(f\"    [Warning] CLF ES invalid ({best_n}) for {target_col}. Defaulting to 100.\")\n        best_n = 100\n        \n    params[\"n_estimators\"] = best_n\n    \n    cv_scores = cv_no_scaling(model=LGBMClassifier(**params), df_subset=df_clean,\n                               feature_cols=feat_cols, target_col=target_col, n_splits=5, gap=0)\n    \n    trial.set_user_attr(\"best_n\", best_n)\n    trial.set_user_attr(\"cv_precision\", cv_scores['precision'][0])\n    return cv_scores['auc'][0]\n\ndef objective_reg_final(trial, df_sub, feat_cols, target_info, target_name):\n    fam = family_for_reg(target_name)\n    target_col, transform_str = target_info\n    df_clean = df_sub.sort_values('checked_at_utc')[feat_cols + [target_col]].replace([np.inf,-np.inf], np.nan).dropna()\n    X, y = df_clean[feat_cols].values, df_clean[target_col].values\n    \n    split_idx = int(len(X) * 0.85)\n    X_tr, X_val = X[:split_idx], X[split_idx:]\n    y_tr_raw, y_val_raw = y[:split_idx], y[split_idx:]\n\n    if transform_str == 'log1p':\n        assert np.all(y_tr_raw > -1.0) and np.all(y_val_raw > -1.0), f\"log1p domain error on {target_col}\"\n        y_tr, y_val = np.log1p(y_tr_raw), np.log1p(y_val_raw)\n    elif transform_str == 'log5p':\n        assert np.all(y_tr_raw > -5.0) and np.all(y_val_raw > -5.0), f\"log5p domain error on {target_col}\"\n        y_tr, y_val = np.log(y_tr_raw+5), np.log(y_val_raw+5)\n    else:\n        y_tr, y_val = y_tr_raw, y_val_raw\n\n    params = build_params(trial, fam)\n    es_model = LGBMRegressor(**params)\n    es_model.fit(X_tr, y_tr, eval_set=[(X_val, y_val)], eval_metric='rmse',\n                 callbacks=[early_stopping(stopping_rounds=50, verbose=False)])\n                 \n    best_n = es_model.best_iteration_\n    if best_n is None or best_n <= 0:\n        print(f\"    [Warning] REG ES invalid ({best_n}) for {target_col}. Defaulting to 100.\")\n        best_n = 100\n        \n    params[\"n_estimators\"] = best_n\n    \n    cv_scores = cv_regression(model=LGBMRegressor(**params), df_subset=df_clean, feature_cols=feat_cols,\n                               target_info=target_info, n_splits=5, gap=0, scale=False)\n                               \n    trial.set_user_attr(\"best_n\", best_n)\n    trial.set_user_attr(\"cv_mae\", cv_scores['mae'][0])\n    return cv_scores['r2'][0]\n\n# ------------------------------------------------------------\n# 3. EXECUTION LOOPS\n# ------------------------------------------------------------\nlightgbm_sweep_final = {'classification': {'LONG': {}, 'SHORT': {}}, 'regression': {'LONG': {}, 'SHORT': {}}}\n\nfor c_target in class_targets:\n    for direction in ['LONG', 'SHORT']:\n        df_sub, feat_cols = direction_map[direction]\n        n_trials = FAMILY_RANGES[\"classification\"][\"n_trials\"]\n        study_name = f\"lgbm_final_clf_{c_target}_{direction}\"\n        \n        study = optuna.create_study(study_name=study_name, storage=f\"sqlite:///{study_name}.db\",\n                                     sampler=optuna.samplers.TPESampler(seed=42),\n                                     direction=\"maximize\", load_if_exists=True)\n                                     \n        remaining = n_trials - len([t for t in study.trials if t.state == TrialState.COMPLETE])\n        \n        try:\n            if remaining > 0:\n                study.optimize(lambda t: objective_clf_final(t, df_sub, feat_cols, c_target), n_trials=remaining)\n                \n            best_p = dict(study.best_params); best_p[\"n_estimators\"] = study.best_trial.user_attrs.get(\"best_n\", 100)\n            best_p[\"learning_rate\"] = 0.05; best_p[\"bagging_freq\"] = 1\n            \n            lightgbm_sweep_final['classification'][direction][c_target] = {\n                'Best_AUC': study.best_value,\n                'Best_Precision': study.best_trial.user_attrs.get(\"cv_precision\"),\n                'Params': best_p\n            }\n            \n            print(f\"[{time.strftime('%H:%M:%S')}] {c_target} | {direction} -> AUC {study.best_value:.4f}\")\n            \n            save_result_dict(lightgbm_sweep_final, \"lightgbm_sweep_final\")\n            save_progress(f\"TPE CLF Sweep completed: {c_target} | {direction}\")\n            \n        except Exception:\n            traceback.print_exc(); continue\n\nfor r_target in reg_targets:\n    for direction in ['LONG', 'SHORT']:\n        df_sub, feat_cols = direction_map[direction]\n        target_info = REG_TARGETS[r_target]\n        fam = family_for_reg(r_target)\n        n_trials = FAMILY_RANGES[fam][\"n_trials\"]\n        study_name = f\"lgbm_final_reg_{r_target}_{direction}\"\n        \n        study = optuna.create_study(study_name=study_name, storage=f\"sqlite:///{study_name}.db\",\n                                     sampler=optuna.samplers.TPESampler(seed=42),\n                                     direction=\"maximize\", load_if_exists=True)\n                                     \n        remaining = n_trials - len([t for t in study.trials if t.state == TrialState.COMPLETE])\n        \n        try:\n            if remaining > 0:\n                study.optimize(lambda t: objective_reg_final(t, df_sub, feat_cols, target_info, r_target), n_trials=remaining)\n                \n            best_p = dict(study.best_params); best_p[\"n_estimators\"] = study.best_trial.user_attrs.get(\"best_n\", 100)\n            best_p[\"learning_rate\"] = 0.05; best_p[\"bagging_freq\"] = 1\n            \n            lightgbm_sweep_final['regression'][direction][r_target] = {\n                'Best_R2': study.best_value,\n                'Best_MAE': study.best_trial.user_attrs.get(\"cv_mae\"),\n                'Params': best_p\n            }\n            \n            print(f\"[{time.strftime('%H:%M:%S')}] {r_target} | {direction} -> R2 {study.best_value:.4f}\")\n            \n            save_result_dict(lightgbm_sweep_final, \"lightgbm_sweep_final\")\n            save_progress(f\"TPE REG Sweep completed: {r_target} | {direction}\")\n            \n        except Exception:\n            traceback.print_exc(); continue\n\n# ------------------------------------------------------------\n# 4. COMPLETENESS CHECK\n# ------------------------------------------------------------\nexpected_clf = {(t,d) for t in class_targets for d in ['LONG','SHORT']}\ngot_clf = {(t,d) for d in lightgbm_sweep_final['classification'] for t in lightgbm_sweep_final['classification'][d]}\nexpected_reg = {(t,d) for t in reg_targets for d in ['LONG','SHORT']}\ngot_reg = {(t,d) for d in lightgbm_sweep_final['regression'] for t in lightgbm_sweep_final['regression'][d]}\n\nif expected_clf - got_clf: print(\"MISSING CLF:\", expected_clf - got_clf)\nif expected_reg - got_reg: print(\"MISSING REG:\", expected_reg - got_reg)\n\nprint(f\"\\n[{time.strftime('%H:%M:%S')}] ALL SWEEPS COMPLETE.\")","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# ============================================================\n# PART C — 3-Way Model Comparison via GitHub Remote Fetch\n# ============================================================\nimport pandas as pd\nimport numpy as np\nimport matplotlib.pyplot as plt\nimport requests\nimport ast\n\n# ------------------------------------------------------------\n# 1. Variables from Section A (Strict Mapping)\n# ------------------------------------------------------------\nclass_targets = ['class_target_1', 'class_target_2', 'class_target_3_corrected', 'class_target_bad']\n# Derived directly from REG_TARGETS keys in Section A.6\nreg_targets = ['profit', 'quality', 'danger', 'entry_timing', 'exit_timing'] \n\n# ------------------------------------------------------------\n# 2. Remote GitHub Fetch Logic\n# ------------------------------------------------------------\ndef fetch_github_json(repo_path):\n    \"\"\"\n    Pulls a JSON file directly from the raw GitHub repository.\n    \"\"\"\n    base_url = \"https://raw.githubusercontent.com/Jeshurun-B/EMA-optimizer-pipeline-v2/main/\"\n    url = base_url + repo_path\n    \n    response = requests.get(url)\n    if response.status_code == 200:\n        return response.json()\n    else:\n        print(f\"[WARNING] Could not fetch remote file: {url} (Status: {response.status_code})\")\n        return {}\n\nprint(\"Fetching historical sweep data directly from GitHub...\")\nrf_raw = fetch_github_json(\"Week_6_results/week7_baselines_to_beat.json\")\nxgb_raw = fetch_github_json(\"Week_7_results/week8_baselines_to_beat.json\")\n\n# Attempt to fetch the final LightGBM sweep. If missing, try the sweep1 backup.\nlgbm_raw = fetch_github_json(\"Week_8_results/lightgbm_sweep_final.json\")\nif not lgbm_raw:\n    print(\"Falling back to lightgbm_sweep_1.json...\")\n    lgbm_raw = fetch_github_json(\"Week_8_results/lightgbm_sweep_1.json\")\n\n# ------------------------------------------------------------\n# 3. Extraction Helper Functions (Handling differing JSON structures)\n# ------------------------------------------------------------\ndef get_rf_score(target, direction):\n    \"\"\" RF JSON uses stringified tuples as keys: \"('target', 'direction')\" \"\"\"\n    key_str = f\"('{target}', '{direction}')\"\n    if key_str in rf_raw:\n        return rf_raw[key_str].get('score', 0.0)\n    return 0.0\n\ndef get_nested_score(data_dict, family, direction, target, metric):\n    \"\"\" XGBoost and LightGBM use nested paths: [family][direction][target][metric] \"\"\"\n    try:\n        return data_dict[family][direction][target][metric]\n    except KeyError:\n        return 0.0\n    except TypeError:\n        return 0.0\n\n# ------------------------------------------------------------\n# 4. Data Aggregation & Winner Logic\n# ------------------------------------------------------------\ncomparison_data = []\n\n# --- Classification (AUC) ---\nfor target in class_targets:\n    for direction in ['LONG', 'SHORT']:\n        \n        rf_score = get_rf_score(target, direction)\n        xgb_score = get_nested_score(xgb_raw, 'classification', direction, target, 'Best_AUC')\n        lgbm_score = get_nested_score(lgbm_raw, 'classification', direction, target, 'Best_AUC')\n        \n        scores = {'RF/LogReg': rf_score, 'XGBoost': xgb_score, 'LightGBM': lgbm_score}\n        winner = max(scores, key=scores.get) if max(scores.values()) > 0 else 'None'\n        \n        comparison_data.append({\n            'Type': 'Classification',\n            'Target': target,\n            'Direction': direction,\n            'Metric': 'AUC',\n            'RF_Score': rf_score,\n            'XGB_Score': xgb_score,\n            'LGBM_Score': lgbm_score,\n            'Winner': winner\n        })\n\n# --- Regression (R2) ---\nfor target in reg_targets:\n    for direction in ['LONG', 'SHORT']:\n        \n        rf_score = get_rf_score(target, direction)\n        xgb_score = get_nested_score(xgb_raw, 'regression', direction, target, 'Best_R2')\n        lgbm_score = get_nested_score(lgbm_raw, 'regression', direction, target, 'Best_R2')\n        \n        scores = {'RF/LogReg': rf_score, 'XGBoost': xgb_score, 'LightGBM': lgbm_score}\n        winner = max(scores, key=scores.get) if max(scores.values()) > 0 else 'None'\n        \n        comparison_data.append({\n            'Type': 'Regression',\n            'Target': target,\n            'Direction': direction,\n            'Metric': 'R2',\n            'RF_Score': rf_score,\n            'XGB_Score': xgb_score,\n            'LGBM_Score': lgbm_score,\n            'Winner': winner\n        })\n\ndf_compare = pd.DataFrame(comparison_data)\n\nprint(\"\\n============================================================\")\nprint(\"3-WAY WINNER DETERMINATION: RF vs XGBoost vs LightGBM\")\nprint(\"============================================================\\n\")\nprint(df_compare.sort_values(['Type', 'Target', 'Direction']).to_string(index=False))\nprint(\"\\n\")\n\n# ------------------------------------------------------------\n# 5. Visual Presentation (3-Bar Grouped Charts)\n# ------------------------------------------------------------\ndef plot_three_way_comparison(df, model_type, metric_name):\n    \"\"\"\n    Renders a side-by-side bar chart comparison for 3 distinct models.\n    \"\"\"\n    sub_df = df[df['Type'] == model_type].copy()\n    if sub_df.empty:\n        return\n        \n    labels = sub_df['Target'] + \"_\" + sub_df['Direction']\n    \n    rf_scores = sub_df['RF_Score'].values\n    xgb_scores = sub_df['XGB_Score'].values\n    lgbm_scores = sub_df['LGBM_Score'].values\n\n    # Mathematical spacing for 3 bars per group\n    x = np.arange(len(labels))\n    width = 0.25 \n\n    fig, ax = plt.subplots(figsize=(16, 6))\n    \n    # Plot bars with geometric offsets to place them left, center, right\n    rects1 = ax.bar(x - width, rf_scores, width, label='RF / LogReg', color='#7f8c8d')  # Gray\n    rects2 = ax.bar(x, xgb_scores, width, label='XGBoost', color='#2980b9')             # Blue\n    rects3 = ax.bar(x + width, lgbm_scores, width, label='LightGBM', color='#27ae60')   # Green\n\n    ax.set_ylabel(f'{metric_name} Score', fontsize=12, fontweight='bold')\n    ax.set_title(f'3-Way Model Comparison: {model_type} ({metric_name})', fontsize=14, fontweight='bold')\n    ax.set_xticks(x)\n    ax.set_xticklabels(labels, rotation=45, ha=\"right\")\n    ax.legend(loc='upper right')\n    ax.grid(axis='y', linestyle='--', alpha=0.7)\n    \n    fig.tight_layout()\n    plt.show()\n\n# Render charts\nplot_three_way_comparison(df_compare, 'Classification', 'AUC')\nplot_three_way_comparison(df_compare, 'Regression', 'R2')","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-07-31T02:25:29.309062Z","iopub.execute_input":"2026-07-31T02:25:29.309545Z","iopub.status.idle":"2026-07-31T02:25:30.687397Z","shell.execute_reply.started":"2026-07-31T02:25:29.309507Z","shell.execute_reply":"2026-07-31T02:25:30.686621Z"},"collapsed":true,"jupyter":{"outputs_hidden":true}},"outputs":[{"name":"stdout","text":"Fetching historical sweep data directly from GitHub...\n\n============================================================\n3-WAY WINNER DETERMINATION: RF vs XGBoost vs LightGBM\n============================================================\n\n          Type                   Target Direction Metric  RF_Score  XGB_Score  LGBM_Score   Winner\nClassification           class_target_1      LONG    AUC    0.6896     0.7033    0.703309 LightGBM\nClassification           class_targe